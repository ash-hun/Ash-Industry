# ──────────────────────────────────────────────
# Ash Industry Settings  (copy to .env and fill in)
# Env prefix: ASH_   |  nested delimiter: __
# ──────────────────────────────────────────────

# LLM Provider
ASH_LLM__PROVIDER=anthropic          # anthropic | openai | ollama | vllm
ASH_LLM__MODEL=claude-sonnet-4-5
ASH_LLM__API_KEY=                    # leave blank for local models, or to read the SDK default (ANTHROPIC_API_KEY)
ASH_LLM__BASE_URL=                   # Ollama: http://localhost:11434  |  vLLM: http://localhost:8000
ASH_LLM__TEMPERATURE=0.7
ASH_LLM__MAX_TOKENS=4096
# Agents whose team/<id>.yaml sets a different provider read that SDK's key (예: provider openai)
OPENAI_API_KEY=

# Inner Thought / Proactive — 기본 ON. 사고 모델을 메인과 분리하면 성찰이 메인 응답을 막지 않는다
# ASH_THOUGHT__ENABLED=true
# ASH_THOUGHT__MODEL=gemma4:e2b-it-qat       # 비우면 메인 모델. 로컬 Ollama 는 이 값으로 고정(0.8b 급은 JSON 을 못 지킨다)
# ASH_THOUGHT__PROVIDER=                     # 비우면 메인 provider 상속 (api_key, base_url 도 같음)
# ASH_THOUGHT__REQUEST_TIMING=after          # before | race | after. 사고와 메인이 같은 GPU 면 after(응답 뒤 사고)
# ASH_THOUGHT__WAIT_SEC=3.0                  # race 에서 사고를 기다리는 상한
# ASH_THOUGHT__ROUTER_MODEL=router           # 지정하면 REQUEST_TIMING 대신 router 가 요청마다 사고 여부를 정한다(scripts/router_server.py)
# ASH_THOUGHT__ROUTER_BASE_URL=http://host.docker.internal:11435
# ASH_THOUGHT__ROUTER_THRESHOLD=0.2          # P(think) 가 이 이상이면 think
# ASH_PROACTIVE__DAEMON_ENABLED=true
# ASH_PROACTIVE__DAEMON_INTERVAL_SEC=120     # 로컬과 배포 모두 같은 값
# ASH_PROACTIVE__DECISION_MODEL=             # 성찰의 '먼저 말할까' 를 decision model 확률로(예: tev1)
# ASH_PROACTIVE__DECISION_BASE_URL=http://host.docker.internal:11434
# ASH_PROACTIVE__DECISION_THRESHOLD=0.6     # decision model 을 쓸 때의 임계치
# 호스트 Ollama 가 성찰과 사용자 요청을 동시에 받게 하려면 (brew): launchctl setenv OLLAMA_NUM_PARALLEL 2 && brew services restart ollama

# Security
ASH_SECURITY__REQUIRE_AUTH=true
# Web HUD 접근 키. 비워두면 web 인증 없음(로컬 단독). 키가 곧 식별자라 길고 무작위여야 한다. TUI는 영향 없음.
# ASH_SECURITY__API_KEYS='{"replace-with-a-long-random-key": {"name": "owner", "roles": ["admin"]}}'
ASH_SECURITY__ALLOWED_ROLES=["user","admin"]
ASH_SECURITY__INPUT_MAX_LENGTH=10000
# ASH_SECURITY__APPROVALS_PATH=~/.ash/approvals.yaml   # 승인 화면에서 "항상 허용"한 (도구, 패턴) 규칙

# Procedures (절차 학습). 같은 종류 작업이 세 번 성공하면 통합 때 초안으로 남긴다. /procedures approve 로 도구화
# ASH_PROCEDURES__ENABLED=true
# ASH_PROCEDURES__DIR=~/.ash/procedures
# ASH_PROCEDURES__MIN_TOOL_CALLS=3

# Notify (외부 알림) — 열린 화면이 없어도 스케줄 결과와 proactive 발화를 슬랙, 디스코드로. 둘 다 있으면 둘 다
# ASH_NOTIFY__SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ASH_NOTIFY__DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# 디스코드에서 에이전트마다 <주소>/<에이전트 id>.png 를 아바타로 쓴다(scripts/capture_avatars.py 가 만든다)
# ASH_NOTIFY__AVATAR_BASE_URL=https://raw.githubusercontent.com/ash-hun/Ash-Industry/main/assets/avatars
# ASH_NOTIFY__KINDS=["reminder","proactive","spoken"]
# 디스코드 봇(선택). 셋 다 있으면 사용자가 음성 채널에 있을 때 봇이 그 채널에서 알림을 읽고, 없으면 webhook 글로 보낸다.
# 봇 권한: Connect, Speak. Developer Portal 의 privileged intent 는 필요 없다. 읽는 목소리는 supertonic(--extra discord)
# ASH_NOTIFY__DISCORD_BOT_TOKEN=
# ASH_NOTIFY__DISCORD_GUILD_ID=      # 서버 id (개발자 모드에서 서버 이름 우클릭 > ID 복사)
# ASH_NOTIFY__DISCORD_USER_ID=       # 내 사용자 id (내 프로필 우클릭 > ID 복사)
# ASH_NOTIFY__DISCORD_VOICE_KINDS=["reminder","proactive"]
# 모바일 앱 Web Push(선택). npx web-push generate-vapid-keys 로 한 번 만든다. 셋 다 있고 세션 저장소가 Postgres 일 때만 켠다
# ASH_NOTIFY__WEBPUSH_VAPID_PUBLIC_KEY=
# ASH_NOTIFY__WEBPUSH_VAPID_PRIVATE_KEY=
# ASH_NOTIFY__WEBPUSH_SUBJECT=mailto:me@example.com
# 모바일 앱 빌드 결과(nginx 가 /m/ 로 서빙). 비우면 ../ash-industry-app/dist
# ASH_APP_DIST=

# Memory
ASH_MEMORY__BACKEND=postgres         # in_memory | postgres
ASH_MEMORY__STM_TURNS=3               # 모델에 넣는 최근 턴 수. 그 밖은 턴마다 쓴 일화에서 회상
# ASH_MEMORY__CONSOLIDATE_ON_IDLE=true   # ASH_PROACTIVE__DAEMON_IDLE_SEC 넘게 조용한 daemon 틱에 턴 일화에서 사실 추출
# 의미 유사도 검색과 약속 중복 판정 (비우면 글자와 키워드로만). Postgres 는 pgvector 확장 필요 (compose 이미지는 포함)
# ASH_MEMORY__EMBEDDING_PROVIDER=ollama  # openai | ollama | vllm
# ASH_MEMORY__EMBEDDING_MODEL=bge-m3     # 한국어는 bge-m3. nomic-embed-text 는 다른 약속끼리도 0.9 가 넘는다
# ASH_MEMORY__EMBEDDING_DIMENSIONS=1024  # vllm 은 필수
# ASH_MEMORY__EMBEDDING_API_KEY=         # 비우면 LLM API 키
# ASH_MEMORY__EMBEDDING_BASE_URL=        # 비우면 provider 기본값
# ASH_MEMORY__POSTGRES_DSN=          # 비워두면 ASH_SESSION__POSTGRES_DSN 사용

# Session
ASH_SESSION__PERSISTENCE_BACKEND=postgres   # jsonl | postgres
ASH_SESSION__SESSIONS_DIR=~/.ash/sessions
# ASH_SESSION__POSTGRES_DSN=postgresql://user:password@host:5432/ash

# Scheduler
# ASH_SCHEDULER__NOTICE_BACKEND=postgres   # in_memory | postgres. 열린 화면이 없을 때 쌓는 알림 보류 큐

# Workflow (HUD FLOW 화면의 위임 그래프와 작업 실행 기록)
# ASH_WORKFLOW__BACKEND=postgres           # in_memory | postgres
# ASH_WORKFLOW__LAYOUT_PATH=~/.ash/workflow_layout.json   # Workflow 그래프에서 옮긴 노드 자리

# UI
ASH_UI__THEME=dark

# Brand — 에이전트 정체성 (Web HUD 워드마크·명언·색감). 에이전트마다 다르게 둔다.
# ASH_BRAND__NAME=A.S.H.
# ASH_BRAND__QUOTE=Proof the Heart
# ASH_BRAND__PERSONA="..."                     # 말투와 성격. 기본은 침착한 집사(ash_config.py DEFAULT_PERSONA). 비우면 모델 기본 말투
# ASH_BRAND__PALETTE__PRIMARY=#5fc8e2          # 링·선·강조 주색 (#rrggbb)
# ASH_BRAND__PALETTE__ACCENT=#f0b35f           # 인디케이터·경고 보조색
# ASH_BRAND__PALETTE__BACKGROUND=#02060c       # 화면 바탕
# ASH_BRAND__PALETTE__NEBULA=["#3a5bff","#8a4dff","#ff6ad5"]  # 리액터 코어 성운 색 (안쪽→바깥)

# Plugins / Tools / Skills
ASH_PLUGIN__PLUGINS_DIR=~/.ash/plugins
ASH_PLUGIN__SKILLS_DIR=./examples/skills        # project built-in skills (or ~/.ash/skills for personal)
ASH_PLUGIN__TOOLS_DIR=~/.ash/tools
ASH_PLUGIN__WATCH_FILES=true
# ASH_AGENTS__SUPERVISOR_PROMPT=~/.ash/supervisor.md   # supervisor 패턴 감독자 지시문(문자열 또는 파일 경로)
# ASH_AGENTS__AGENTS_DIR=/app/team/agents   # 서브 에이전트 정의. compose 기본값. 로컬 실행은 ~/.ash/agents
# docker: 개인 프로필 저장소(team/, skills/, extensions/, settings.yaml). 비우면 저장소의 examples/
# ASH_PROFILE_DIR=../my-profile
# ASH_TEAM__DIR=~/.ash/team   # main 과 같은 층의 최상위 에이전트 정의(파일 이름이 id). docker 는 ASH_PROFILE_DIR/team 을 쓴다

# Timezone — 스케줄(cron)·/schedule 마감 시각을 해석하는 기준 (docker compose 기본값 Asia/Seoul)
# TZ=Asia/Seoul

# Voice — 영어 문장만 Piper 음성 모델로 서버에서 읽는다. 한국어는 TTS_PROVIDER(browser 면 브라우저)가 읽는다.
# 모델은 ~/.ash/voices/ 에 .onnx 와 .onnx.json 을 같이 둔다. 받는 법은 문서의 Voice Interface 페이지에 있다.
# ASH_VOICE__TTS_PROVIDER=browser
# ASH_VOICE__ENGLISH_TTS_PROVIDER=piper     # qwen: Mac 호스트의 합성 서버(services/qwen_tts). 닿지 않으면 PIPER_MODEL 로 읽는다
# ASH_VOICE__QWEN_URL=http://host.docker.internal:8770
# ASH_VOICE__SPEAK_ENGLISH=true          # main 의 한국어 답을 소리로만 영어로 옮겨 영어 TTS 로 읽는다
# Docker 는 저장소의 models/ 를 /app/models 로 마운트한다(git 에는 없다. 채우는 법은 문서의 Voice Interface)
# ASH_VOICE__PIPER_MODEL=/app/models/tts/voice.onnx
# ASH_VOICE__PHRASES_DIR=/app/models/tts/phrases      # 미리 녹음한 읽기 문구. 비우면 끈다
# ASH_VOICE__WAKE_MODEL_DIR=/app/models/wakeword      # 웨이크워드 모델 디렉터리(모드 무관). 비우면 끈다
# ASH_VOICE__WAKE_THRESHOLD=0.5
# ASH_VOICE__PIPER_NOISE_SCALE=0.4

# Focus — /focus <작업> 동안 조사, 기록, 분석, 진행 sub-agent 넷을 붙인다. 기록은 DIR 아래 작업마다 남는다.
# ASH_FOCUS__ENABLED=true
# ASH_FOCUS__MODEL=gpt-4o-mini
# ASH_FOCUS__DIR=~/.ash/focus
# ASH_FOCUS__READY_TIMEOUT_SEC=30

# Misc
ASH_DEBUG=false
ASH_LOG_LEVEL=INFO
# 로그 형식. console(기본, 사람이 읽는 콘솔) | json(운영, 한 줄에 객체 하나)
LOG_FORMAT=console

# ── MCP 도구 컨테이너(ash-mcp) ──
# 외부 서비스의 MCP 서버는 전부 ash-mcp 컨테이너 하나에 모아 띄우고(mcp/servers.yaml), 백엔드는 HTTP 로 붙는다.
# 서버 목록은 JSON 배열. 기본값은 docker-compose.yml 에 있다(google 하나). 서버를 더하면 전체를 다시 적는다.
# ASH_MCP_SERVERS=[{"name":"google","transport":"streamable-http","url":"http://ash-mcp:8000/mcp","timeout":60}]
# Google Workspace MCP(workspace-mcp): Google Cloud 의 OAuth 클라이언트. 콜백 http://localhost:8808/oauth2callback
# MCP_GOOGLE_PORT=8808   # 호스트에서 콜백을 받는 포트. 8000 이 다른 컨테이너에 잡혀 있어 기본을 8808 로 둔다
# 행정문서 폴더(docs MCP 서버가 보는 유일한 경로). 비우면 ~/Documents/ash
# ASH_DOCS_DIR=~/Documents/ash
# 채팅 첨부를 두는 호스트 폴더. 24시간이 지난 파일은 지운다(ASH_DOCS__UPLOAD_TTL_HOURS)
# ASH_UPLOAD_DIR=/tmp/ash-uploads
# 미디어 결과물 폴더(영상, 음악, 이미지). 확장이나 외부 워커가 쓴 파일을 HUD 가 /data/creative 에서 읽어 보여 준다
# ASH_CREATIVE_DIR=~/Creative/ash
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# OAUTHLIB_INSECURE_TRANSPORT=1
# USER_GOOGLE_EMAIL=
